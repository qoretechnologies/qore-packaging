+@pytest.mark.parametrize("function", [pc.rank, pc.rank_quantile, pc.rank_normal])
+@pytest.mark.parametrize("order", ["ascending", "descending"])
+@pytest.mark.parametrize("placement", ["at_start", "at_end"])
+def test_rank_legacy_null_placement_warning(function, order, placement):
+    # Copyright 2026 Qore Technologies, s.r.o.
+    # Retain legacy behavior coverage and require its documented diagnostic.
+    arr = pa.array([None, 2, 1, None, 2])
+    with pytest.warns(FutureWarning, match=(
+            "Specifying null_placement in RankOptions is deprecated "
+            "as of 25.0.0")) as diagnostics:
+        legacy = function(arr, sort_keys=order, null_placement=placement)
+    assert len(diagnostics) == 1
+    current = function(arr, sort_keys=[("", order, placement)])
+    assert legacy.equals(current)
 
 
