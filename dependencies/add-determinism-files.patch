diff --git a/tests/test_add_det.rs b/tests/test_add_det.rs
index 864de50..e0a6a9d 100644
--- a/tests/test_add_det.rs
+++ b/tests/test_add_det.rs
@@ -109,3 +109,23 @@ fn test_invocation_check2() {
     let c = invoke(["--check", "--handler=ar", dir.path().to_str().unwrap()]);
     assert!(c.status.success());
 }
+
+// Copyright (C) 2026 Qore Technologies, s.r.o.
+#[test]
+fn test_pending_output_is_excluded_from_walk() {
+    use add_determinism::add_det::handlers::{InputOutputHelper, process_file_or_dir};
+    let dir = common::empty_dir().unwrap();
+    let input = dir.path().join("document.html");
+    std::fs::write(&input, b"unchanged document").unwrap();
+    for check in [false, true] {
+        let (mut io, _reader) = InputOutputHelper::open(&input, check, false).unwrap();
+        io.open_output(true).unwrap();
+        let stats = process_file_or_dir(&[], &mut std::collections::HashMap::new(),
+                                       dir.path(), None);
+        assert_eq!(stats.errors, 0);
+        assert_eq!(stats.files, 1, "temporary output must not enter the file walk");
+        drop(io);
+        assert_eq!(std::fs::read_dir(dir.path()).unwrap().count(), 1);
+        assert_eq!(std::fs::read(&input).unwrap(), b"unchanged document");
+    }
+}
