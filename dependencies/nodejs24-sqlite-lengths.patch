From: Qore Technologies <info@qoretechnologies.com>
Subject: Calculate changegroup value allocation lengths without signed overflow

Copyright 2026 Qore Technologies, s.r.o.; MIT.
The value and varint lengths were added as int before conversion to int64.
At INT_MAX, both text and blob APIs overflow and bypass buffer allocation.
Keep strlen in size_t until its length is checked, and promote the addition
before it executes. Oversized values follow the existing SQLITE_NOMEM path.

--- a/deps/sqlite/sqlite3.c
+++ b/deps/sqlite/sqlite3.c
@@ -240413,8 +240413,12 @@
   const char *pVal,
   int nVal
 ){
-  int nText = nVal>=0 ? nVal : strlen(pVal);
-  sqlite3_int64 nByte = 1 + sessionVarintLen(nText) + nText;
+  size_t nText = nVal>=0 ? (size_t)nVal : strlen(pVal);
+  sqlite3_int64 nByte;
+  if( nText>0x7fffffff ){
+    return SQLITE_NOMEM;
+  }
+  nByte = 1 + sessionVarintLen((int)nText) + (sqlite3_int64)nText;
   int rc = SQLITE_OK;
   SessionBuffer *pBuf = 0;
 
@@ -240440,7 +240444,7 @@
   const void *pVal,
   int nVal
 ){
-  sqlite3_int64 nByte = 1 + sessionVarintLen(nVal) + nVal;
+  sqlite3_int64 nByte = 1 + sessionVarintLen(nVal) + (sqlite3_int64)nVal;
   int rc = SQLITE_OK;
   SessionBuffer *pBuf = 0;
 
