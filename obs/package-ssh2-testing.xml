<package name="qore-ssh2-module" project="home:davidnichols:qore:testing">
  <title>Qore ssh2 module</title>
  <description>Pinned sources with local RPM and installed runtime qualification on all three targets.</description>
  <build>
    <disable/>
    <enable arch="x86_64" repository="Fedora_44"/>
    <enable arch="x86_64" repository="openSUSE_Leap_16.0"/>
    <enable arch="x86_64" repository="AlmaLinux_10"/>
    <enable arch="aarch64" repository="Fedora_44"/>
    <enable arch="aarch64" repository="openSUSE_Leap_16.0"/>
    <enable arch="aarch64" repository="AlmaLinux_10"/>
  </build>
  <publish>
    <disable/>
  </publish>
  <url>https://github.com/qoretechnologies/module-ssh2</url>
</package>
