<package name="qore-pgsql-module" project="home:davidnichols:qore:testing">
  <title>Qore PostgreSQL database driver</title>
  <description>Native PostgreSQL bindings with offline private-database tests and mandatory Fedora pgvector coverage.</description>
  <build>
    <disable/>
    <enable arch="x86_64" repository="Fedora_44"/>
    <enable arch="aarch64" repository="Fedora_44"/>
    <enable arch="x86_64" repository="openSUSE_Leap_16.0"/>
    <enable arch="x86_64" repository="AlmaLinux_10"/>
    <enable arch="aarch64" repository="openSUSE_Leap_16.0"/>
    <enable arch="aarch64" repository="AlmaLinux_10"/>
  </build>
  <publish>
    <disable/>
  </publish>
  <url>https://github.com/qoretechnologies/module-pgsql</url>
</package>
