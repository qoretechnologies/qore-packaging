  "scope": [
    {
      "message": "AMQ222149",
      "cause": "The rejection tests deliberately reject deliveries; Artemis routes them to its dead-letter queue. Twenty native Proton cycles pass normally and under Valgrind."
    },
    {
      "messages": [
        "AMQ111007",
        "AMQ119027"
      ],
      "cause": "The client closes its connection while an asynchronous receiver-link initialization is still pending. DefaultSenderController.validateConnectionState logs and rejects the already-closed endpoint. Twenty native Proton cycles reproduce the exact message independently of Qore, both normally and under Valgrind."
    },
    {
      "message": "AMQ222208",
      "cause": "Wrong CA/hostname controls cause the Java TLS server to report a short alert record as an AEAD BadPaddingException; missing mutual-TLS identity produces Empty client certificate chain. Python SSL reproduces both exact server messages while correctly rejecting clients. Trusted CA and mutual identities succeed."
    },
    {
      "message": "AMQ212037 ... REMOTE_DISCONNECT",
      "cause": "Standalone TLS controls intentionally close the underlying connection after the SASL protocol header; the broker reports abrupt AMQP transport termination. This additional scope is limited to that control, not Qore runtime qualification."
    }
  ],
  "proof": {
    "native_controls": 80,
    "native_memory": "Zero memory errors and zero definite, indirect or possible lost allocations in both 20-cycle controls. Distribution process-lifetime reachable allocations remain visible.",
    "tls_controls": 20,
    "qore_functional_cases": 510,
    "qore_functional_assertions": 1155,
    "tls_evidence": "Passing controls6 run of the exact preserved tls-control.py; four passes for each of five trust/identity cases."
  },
  "sources": [
    "https://raw.githubusercontent.com/apache/activemq-artemis/2.38.0/artemis-protocols/artemis-amqp-protocol/src/main/java/org/apache/activemq/artemis/protocol/amqp/proton/DefaultSenderController.java"
  ],
  "fixture_fixes": [
    "Use an accessible working directory, eliminating the launch-script /home/jboss permission error.",
    "Create/start the container before measuring its startup-event deadline; Docker API queue delay is not broker startup time. The readiness event and timeout remain unchanged."
  ],
