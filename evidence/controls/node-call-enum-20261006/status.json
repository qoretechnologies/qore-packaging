[
  {
    "name": "release-wasm0-compile",
    "command": [
      "g++",
      "-std=c++20",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "-DV8_ENABLE_WEBASSEMBLY=0",
      "/work/control.cc",
      "-o",
      "/work/control-release-wasm0"
    ],
    "exit_code": 0
  },
  {
    "name": "release-wasm0-normal",
    "command": [
      "/work/control-release-wasm0"
    ],
    "exit_code": 0
  },
  {
    "name": "release-wasm0-memory",
    "command": [
      "valgrind",
      "--error-exitcode=99",
      "--leak-check=full",
      "--errors-for-leak-kinds=all",
      "--log-file=/work/release-wasm0-valgrind.log",
      "/work/control-release-wasm0"
    ],
    "exit_code": 0
  },
