[
  {
    "name": "release-compile",
    "command": [
      "g++",
      "-std=c++20",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "/work/control.cc",
      "-I/source/deps/v8/include",
      "-Wno-unused-parameter",
      "-o",
      "/work/control-release"
    ],
    "exit_code": 0
  },
  {
    "name": "release-normal",
    "command": [
      "/work/control-release"
    ],
    "exit_code": 0
  },
  {
    "name": "release-memory",
    "command": [
      "valgrind",
      "--error-exitcode=99",
      "--leak-check=full",
      "--errors-for-leak-kinds=all",
      "--log-file=/work/release-valgrind2.log",
      "/work/control-release"
    ],
    "exit_code": 0
  },
  {
    "name": "debug-compile",
    "command": [
      "g++",
      "-std=c++20",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "-DDEBUG",
      "/work/control.cc",
      "-I/source/deps/v8/include",
      "-Wno-unused-parameter",
      "-o",
      "/work/control-debug"
    ],
    "exit_code": 0
  },
  {
    "name": "debug-normal",
    "command": [
      "/work/control-debug"
    ],
    "exit_code": 0
  },
  {
    "name": "debug-memory",
    "command": [
      "valgrind",
      "--error-exitcode=99",
      "--leak-check=full",
      "--errors-for-leak-kinds=all",
      "--log-file=/work/debug-valgrind2.log",
      "/work/control-debug"
    ],
    "exit_code": 0
  }
]
