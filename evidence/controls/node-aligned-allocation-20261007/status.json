[
  {
    "name": "release-4-compile",
    "command": [
      "g++",
      "-std=c++20",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "-Wno-unused-parameter",
      "-DTEST_TAGGED_SIZE=4",
      "/work/control.cc",
      "/work/helper.cc",
      "-o",
