+// Remove one due JWT using the caller's time snapshot. Store lock must be held.
+func (store *DirJWTStore) expireOneLocked(pq *expirationTracker, now int64) bool {
+	if pq.Len() > 0 {
+		if it := pq.heap[0]; it.expiration <= now {
+			path := store.pathForKey(it.publicKey)
+			if err := os.Remove(path); err == nil {
+				heap.Pop(pq)
+				pq.unTrack(it.publicKey)
+				xorAssign(&pq.hash, it.hash)
+				return true
+			}
+		}
+	}
+	return false
+}
