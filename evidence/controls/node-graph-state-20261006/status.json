[
  {
    "name": "compile",
    "command": [
      "g++",
      "-std=c++20",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "-Wmaybe-uninitialized",
      "-I/source/deps/v8",
      "/fixture/control.cc",
      "-o",
      "/fixture/control"
    ],
    "exit_code": 0
  },
  {
    "name": "normal",
    "command": [
      "/fixture/control"
    ],
    "exit_code": 0
  },
  {
    "name": "memory",
    "command": [
      "valgrind",
      "--error-exitcode=99",
      "--leak-check=full",
      "--show-leak-kinds=all",
      "--errors-for-leak-kinds=all",
      "--log-file=/fixture/valgrind.log",
      "/fixture/control"
    ],
    "exit_code": 0
  }
]
