[
  {
    "name": "original-debug-compile",
    "command": [
      "g++",
      "-std=c++20",
      "-g",
      "-O0",
      "-Wall",
      "-Wextra",
      "-DDEBUG",
      "/work/original.cc",
      "-o",
      "/work/original-debug"
    ],
    "exit_code": 0
  },
  {
    "name": "original-debug-normal",
