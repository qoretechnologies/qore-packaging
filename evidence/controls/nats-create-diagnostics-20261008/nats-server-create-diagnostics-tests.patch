+func TestJetStreamCreateDiagnostics(t *testing.T) {
+	for _, replicas := range []int{1, 3} {
+		t.Run(fmt.Sprintf("R%d", replicas), func(t *testing.T) {
+			c := createJetStreamClusterExplicit(t, "CREATE-DIAG", 3)
+			defer c.shutdown()
+			originals := make([]*subscription, len(c.servers))
+			for i, s := range c.servers {
+				originals[i] = s.getJetStream().apiSubs.Match(fmt.Sprintf(JSApiStreamCreateT, "TEST")).psubs[0]
+			}
+			d := observeRPMCreates(t, c, []string{"TEST", "MISSING"})
+			defer d.finish(t)
+			before := strings.Join(d.snapshot(), "\n")
+			require_Equal(t, strings.Count(before, "stream=TEST assigned=false"), 3)
+			nc, js := jsClientConnect(t, c.randomServer())
+			defer nc.Close()
+			info, err := js.AddStream(&nats.StreamConfig{Name: "TEST", Subjects: []string{"foo"}, Replicas: replicas, Storage: nats.MemoryStorage})
+			require_NoError(t, err)
+			require_Equal(t, info.Config.Replicas, replicas)
+			after := strings.Join(d.snapshot(), "\n")
+			require_True(t, strings.Contains(after, "stream=TEST assigned=true"))
+			require_Equal(t, strings.Count(after, "stream=MISSING assigned=false"), 3)
+			entries := 0
+			for _, log := range d.logs {
+				log.mu.Lock()
+				for _, line := range log.lines {
+					if strings.Contains(line, "create-entry ") {
+						entries++
+					}
+				}
+				log.mu.Unlock()
+			}
+			require_True(t, entries > 0)
+			d.stop()
+			d.stop()
+			for i, s := range c.servers {
+				require_True(t, s.getJetStream().apiSubs.Match(fmt.Sprintf(JSApiStreamCreateT, "TEST")).psubs[0] == originals[i])
+			}
+			_, err = js.AddStream(&nats.StreamConfig{Name: "AFTER", Subjects: []string{"after"}, Replicas: replicas, Storage: nats.MemoryStorage})
+			require_NoError(t, err)
+		})
+	}
+}
+
+func TestRPMCreationLoggerBounds(t *testing.T) {
+	log := &rpmCreationLogger{}
+	var workers sync.WaitGroup
+	for writer := 0; writer < 4; writer++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for n := 0; n < 3000; n++ {
+				log.record("CONTROL", "writer=%d event=%d", writer, n)
+			}
+		}()
+	}
+	workers.Wait()
+	require_Equal(t, len(log.lines), 10000)
+	require_Equal(t, log.dropped, 2000)
+	for _, line := range log.lines {
+		require_True(t, strings.Contains(line, " CONTROL writer="))
+	}
+}
