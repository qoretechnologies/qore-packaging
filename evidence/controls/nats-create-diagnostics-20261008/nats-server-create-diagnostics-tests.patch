+// Copyright 2026 Qore Technologies, s.r.o.; Apache-2.0.
+type rpmCreateDiagnostics struct {
+	cluster *cluster
+	names   []string
+	logs    []*rpmCreationLogger
+	restore []func()
+	once    sync.Once
+}
+
+// observeRPMCreates records existing diagnostics and real API callback entry and
+// return. It never waits, retries a request or changes its response/deadline.
+func observeRPMCreates(t *testing.T, c *cluster, names []string) *rpmCreateDiagnostics {
+	t.Helper()
+	d := &rpmCreateDiagnostics{cluster: c, names: append([]string(nil), names...)}
+	t.Cleanup(d.stop)
+	for _, srv := range c.servers {
+		log := &rpmCreationLogger{}
+		d.logs = append(d.logs, log)
+		originalLogger := srv.Logger()
+		debug := atomic.LoadInt32(&srv.logging.debug) != 0
+		trace := atomic.LoadInt32(&srv.logging.trace) != 0
+		sysTrace := atomic.LoadInt32(&srv.logging.traceSysAcc) != 0
+		srv.SetLogger(log, true, false)
+		d.restore = append(d.restore, func() { srv.SetLoggerV2(originalLogger, debug, trace, sysTrace) })
+		api := srv.getJetStream().apiSubs
+		matches := api.Match(fmt.Sprintf(JSApiStreamCreateT, "TEST")).psubs
+		require_Equal(t, len(matches), 1)
+		original := matches[0]
+		replacement := &subscription{subject: append([]byte(nil), original.subject...), icb: func(sub *subscription, client *client, acc *Account, subject, reply string, msg []byte) {
+			log.record("API", "create-entry subject=%q reply=%q api_leader=%v", subject, reply, srv.JetStreamIsLeader())
+			original.icb(sub, client, acc, subject, reply, msg)
+			log.record("API", "create-return subject=%q reply=%q api_leader=%v", subject, reply, srv.JetStreamIsLeader())
+		}}
+		require_NoError(t, api.Remove(original))
+		d.restore = append(d.restore, func() {
+			api.Remove(replacement)
+			if err := api.Insert(original); err != nil {
+				t.Errorf("restore stream-create API subscription: %v", err)
+			}
+		})
+		require_NoError(t, api.Insert(replacement))
+	}
+	return d
+}
+
+func (d *rpmCreateDiagnostics) stop() {
+	d.once.Do(func() {
+		for i := len(d.restore) - 1; i >= 0; i-- {
+			d.restore[i]()
+		}
+	})
+}
+
+// snapshot reads assignment metadata under its owning lock. Raft methods are
+// called after releasing that lock. Fields are observations, not an atomic view
+// of the whole cluster; each line carries the server and current term.
+func (d *rpmCreateDiagnostics) snapshot() []string {
+	var lines []string
+	for _, srv := range d.cluster.servers {
+		js := srv.getJetStream()
+		if js == nil {
+			lines = append(lines, fmt.Sprintf("server=%s JetStream=absent", srv.Name()))
+			continue
+		}
+		js.mu.RLock()
+		cc := js.cluster
+		if cc == nil {
+			js.mu.RUnlock()
+			lines = append(lines, fmt.Sprintf("server=%s cluster=absent", srv.Name()))
+			continue
+		}
+		node, term := cc.meta, cc.term
+		for _, name := range d.names {
+			sa := cc.streams[globalAccountName][name]
+			if sa == nil {
+				lines = append(lines, fmt.Sprintf("server=%s term=%d stream=%s assigned=false", srv.Name(), term, name))
+			} else {
+				group := "<nil>"
+				if sa.Group != nil {
+					group = sa.Group.Name
+				}
+				lines = append(lines, fmt.Sprintf("server=%s term=%d stream=%s assigned=true group=%s reply=%q responded=%v recovering=%v error=%v", srv.Name(), term, name, group, sa.Reply, sa.hasResponded(), sa.recovering, sa.err))
+			}
+		}
+		js.mu.RUnlock()
+		if node != nil {
+			index, commit, applied := node.Progress()
+			lines = append(lines, fmt.Sprintf("server=%s api_leader=%v raft_state=%v raft_term=%d raft_leader=%s index=%d commit=%d applied=%d", srv.Name(), srv.JetStreamIsLeader(), node.State(), node.Term(), node.GroupLeader(), index, commit, applied))
+		}
+	}
+	return lines
+}
+
+func (d *rpmCreateDiagnostics) finish(t *testing.T) {
+	t.Helper()
+	if t.Failed() {
+		for _, line := range d.snapshot() {
+			t.Log(line)
+		}
+		for i, log := range d.logs {
+			log.mu.Lock()
+			lines := append([]string(nil), log.lines...)
+			dropped := log.dropped
+			log.mu.Unlock()
+			t.Logf("creation diagnostics server=%s events=%d dropped=%d", d.cluster.servers[i].Name(), len(lines), dropped)
+			for _, line := range lines {
+				t.Log(line)
+			}
+		}
+	}
+	d.stop()
+}
