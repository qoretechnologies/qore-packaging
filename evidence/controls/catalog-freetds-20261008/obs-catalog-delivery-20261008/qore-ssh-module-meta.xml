<package name="qore-ssh-module" project="home:davidnichols:qore:testing">
  <title>Qore ssh module</title>
  <description>Pinned module sources qualified locally on Fedora, Enterprise Linux and openSUSE.</description>
  <build>
    <disable/>
    <enable arch="x86_64" repository="Fedora_44"/>
    <enable arch="x86_64" repository="openSUSE_Leap_16.0"/>
    <enable arch="x86_64" repository="AlmaLinux_10"/>
    <enable arch="aarch64" repository="Fedora_44"/>
    <enable arch="aarch64" repository="openSUSE_Leap_16.0"/>
    <enable arch="aarch64" repository="AlmaLinux_10"/>
  </build>
  <publish>
    <disable/>
  </publish>
  <url>https://github.com/qoretechnologies/module-ssh</url>
</package>
