<package name="qore-zip-module" project="home:davidnichols:qore:testing">
  <title>Qore ZIP archive module</title>
  <description>Pinned ZIP module sources with offline minizip, all compression and encryption features, and native memory regression tests.</description>
  <build>
    <disable/>
    <enable arch="x86_64" repository="Fedora_44"/>
    <enable arch="aarch64" repository="Fedora_44"/>
    <enable arch="x86_64" repository="openSUSE_Leap_16.0"/>
    <enable arch="x86_64" repository="AlmaLinux_10"/>
    <enable arch="aarch64" repository="openSUSE_Leap_16.0"/>
    <enable arch="aarch64" repository="AlmaLinux_10"/>
  </build>
  <publish>
    <disable/>
  </publish>
  <url>https://github.com/qoretechnologies/module-zip</url>
</package>
