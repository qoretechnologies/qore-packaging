[
  {
    "name": "release-compile",
    "command": [
      "g++",
      "-std=c++20",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "-DNDEBUG",
      "/control/control.cc",
      "-o",
      "/control/release"
    ],
    "exit_code": 0
  },
  {
    "name": "release-normal",
    "command": [
      "/control/release"
    ],
    "exit_code": 0
  },
  {
    "name": "release-valgrind",
    "command": [
      "valgrind",
      "--error-exitcode=99",
      "--leak-check=full",
      "--show-leak-kinds=all",
      "--errors-for-leak-kinds=all",
      "/control/release"
    ],
    "exit_code": 0
  },
  {
    "name": "debug-compile",
    "command": [
      "g++",
      "-std=c++20",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "-DDEBUG",
      "/control/control.cc",
      "-o",
      "/control/debug"
    ],
    "exit_code": 0
  },
  {
    "name": "debug-normal",
    "command": [
      "/control/debug"
    ],
    "exit_code": 0
  },
  {
    "name": "debug-valgrind",
    "command": [
      "valgrind",
      "--error-exitcode=99",
      "--leak-check=full",
      "--show-leak-kinds=all",
      "--errors-for-leak-kinds=all",
      "/control/debug"
    ],
    "exit_code": 0
  }
]
