+func TestConsumerCreationDoesNotJoinAsyncPublications(t *testing.T) {
+	for _, storage := range []nats.StorageType{nats.MemoryStorage, nats.FileStorage} {
+		t.Run(storage.String(), func(t *testing.T) {
+			s := RunBasicJetStreamServer(t)
+			defer s.Shutdown()
+			nc, js := jsClientConnect(t, s)
+			defer nc.Close()
+			_, err := js.AddStream(&nats.StreamConfig{Name: "TEST", Subjects: []string{"KV.*.*"},
+				MaxMsgsPerSubject: 2, Storage: storage})
+			require_NoError(t, err)
+			mset, err := s.GlobalAccount().lookupStream("TEST")
+			require_NoError(t, err)
+			// The real stream's atomic-publication lock delays persistence while
+			// the independent API handler remains able to create a consumer.
+			mset.isolateMu.Lock()
+			locked := true
+			defer func() {
+				if locked {
+					mset.isolateMu.Unlock()
+				}
+			}()
+			subjects := []string{"KV.plans.foo", "KV.plans.bar", "KV.plans.baz",
+				"KV.config.foo", "KV.config.bar", "KV.config.baz", "KV.plans.bar", "KV.plans.baz"}
+			futures := make([]nats.PubAckFuture, 0, len(subjects))
+			for _, subject := range subjects {
+				future, err := js.PublishAsync(subject, []byte("OK"))
+				require_NoError(t, err)
+				futures = append(futures, future)
+			}
+			require_NoError(t, nc.FlushTimeout(time.Second))
+			config := nats.ConsumerConfig{Durable: "BEFORE", AckPolicy: nats.AckExplicitPolicy,
+				DeliverPolicy: nats.DeliverLastPerSubjectPolicy, FilterSubject: "KV.plans.*"}
+			before, err := js.AddConsumer("TEST", &config)
+			require_NoError(t, err)
+			require_Equal(t, before.NumPending, uint64(0))
+			mset.isolateMu.Unlock()
+			locked = false
+			select {
+			case <-js.PublishAsyncComplete():
+			case <-time.After(time.Second):
+				t.Fatal("publication completion missing")
+			}
+			for i, future := range futures {
+				select {
+				case ack := <-future.Ok():
+					require_Equal(t, ack.Sequence, uint64(i+1))
+				case err := <-future.Err():
+					t.Fatalf("publication failed: %v", err)
+				default:
+					t.Fatal("completed publication has no result")
+				}
+			}
+			config.Durable = "AFTER"
+			after, err := js.AddConsumer("TEST", &config)
+			require_NoError(t, err)
+			require_Equal(t, after.NumPending, uint64(3))
+		})
+	}
+}
+
+func TestAsyncPublicationCompletionIncludesFailure(t *testing.T) {
+	s := RunBasicJetStreamServer(t)
+	defer s.Shutdown()
+	nc, js := jsClientConnect(t, s)
+	defer nc.Close()
+	future, err := js.PublishAsync("not.stored", []byte("OK"))
+	require_NoError(t, err)
+	select {
+	case <-js.PublishAsyncComplete():
+	case <-time.After(5 * time.Second):
+		t.Fatal("failed publication did not complete")
+	}
+	select {
+	case err := <-future.Err():
+		require_Error(t, err, nats.ErrNoResponders)
+	case <-future.Ok():
+		t.Fatal("missing stream publication unexpectedly succeeded")
+	default:
+		t.Fatal("completed publication has no result")
+	}
+}
