#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.; SPDX-License-Identifier: MIT
%modern
%requires odbc
int count = int(ARGV[0]);
for (int i = 0; i < count; ++i) {
    Datasource ds(ENV.QORE_DB_CONNSTR_ODBC);
    ds.open();
    on_exit ds.close();
    on_error ds.rollback();
    ds.setOption("numeric-numbers", True);
    hash<auto> row = ds.selectRow("SELECT %v::numeric AS value", 1.25n);
    if (row.value != 1.25n) {
        throw "BAD-NUMERIC", sprintf("iteration %d: %y", i, row);
    }
    ds.commit();
}
printf("Verified %d numeric connection lifetimes\n", count);
