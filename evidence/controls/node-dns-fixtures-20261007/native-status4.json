[
  {
    "name": "versions",
    "command": [
      "rpm",
      "-qa",
      "*cares*"
    ],
    "exit_code": 0
  },
  {
    "name": "compile",
    "command": [
      "gcc",
      "-std=c11",
      "-O2",
      "-g",
      "-Wall",
      "-Wextra",
      "-Werror",
      "/control/control.c",
      "-lcares",
      "-o",
      "/control/control"
    ],
    "exit_code": 0
  },
  {
    "name": "normal",
    "command": [
      "/control/control"
    ],
    "exit_code": 0
  },
  {
    "name": "memory",
    "command": [
      "valgrind",
      "--error-exitcode=99",
      "--leak-check=full",
      "--errors-for-leak-kinds=all",
      "--log-file=/control/native-valgrind4.log",
      "/control/control"
    ],
    "exit_code": 0
  }
]
