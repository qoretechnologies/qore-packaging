+func TestMemStoreSparseIndexReference(t *testing.T) {
+	ms, err := newMemStore(&StreamConfig{Storage: MemoryStorage, MaxMsgs: 37, MaxMsgsPer: 5})
+	require_NoError(t, err)
+	defer ms.Stop()
+	subjects := []string{"foo.a", "foo.b", "bar", "sparse"}
+	check := func() {
+		t.Helper()
+		// The reference scans live messages directly, independently of subject
+		// state and the sequence index used by filtered delivery.
+		ms.mu.RLock()
+		live := make(map[uint64]string, len(ms.msgs))
+		probes := []uint64{0, ms.state.FirstSeq, ms.state.LastSeq, ms.state.LastSeq + 1}
+		for seq, sm := range ms.msgs {
+			live[seq] = sm.subj
+			probes = append(probes, seq, seq+1)
+		}
+		ms.fss.IterFast(func(subj []byte, ss *memSubjectState) bool {
+			var expected, indexed []uint64
+			for seq, name := range live {
+				if name == string(subj) {
+					expected = append(expected, seq)
+				}
+			}
+			slices.Sort(expected)
+			if ss.seqs != nil {
+				ss.seqs.Range(func(seq uint64) bool { indexed = append(indexed, seq); return true })
+			}
+			if len(expected) == 1 && len(indexed) == 0 {
+				if ss.First != expected[0] || ss.Last != expected[0] {
+					t.Errorf("unindexed single-message subject %s has stale bounds", subj)
+				}
+			} else if !slices.Equal(expected, indexed) {
+				t.Errorf("subject %s: index=%v messages=%v", subj, indexed, expected)
+			}
+			return true
+		})
+		ms.mu.RUnlock()
+		for _, filter := range append(append([]string{}, subjects...), "missing", "foo.*", ">", "") {
+			for _, start := range probes {
+				want := uint64(0)
+				for seq, subj := range live {
+					if seq >= start && (filter == "" || filter == ">" || subj == filter || (filter == "foo.*" && (subj == "foo.a" || subj == "foo.b"))) && (want == 0 || seq < want) {
+						want = seq
+					}
+				}
+				var reuse StoreMsg
+				sm, seq, err := ms.LoadNextMsg(filter, subjectHasWildcard(filter), start, &reuse)
+				if want == 0 {
+					if !errors.Is(err, ErrStoreEOF) || sm != nil {
+						t.Fatalf("filter %q start %d: expected EOF, got %v %v", filter, start, sm, err)
+					}
+				} else if err != nil || sm != &reuse || seq != want || sm.seq != want || sm.subj != live[want] {
+					t.Fatalf("filter %q start %d: expected %d, got %d %v", filter, start, want, seq, err)
+				}
+			}
+		}
+	}
+	check()
+	// Removing both ends before reinserting exposed stale bounds in the first
+	// prototype. The survivor must seed the new two-message index correctly.
+	for i := 0; i < 3; i++ {
+		_, _, err = ms.StoreMsg("sparse", nil, nil, 0)
+		require_NoError(t, err)
+	}
+	_, err = ms.RemoveMsg(1)
+	require_NoError(t, err)
+	_, err = ms.RemoveMsg(3)
+	require_NoError(t, err)
+	_, _, err = ms.StoreMsg("sparse", nil, nil, 0)
+	require_NoError(t, err)
+	check()
+	rng := rand.New(rand.NewPCG(20261008, 276))
+	for i := 0; i < 600; i++ {
+		state := ms.State()
+		switch rng.IntN(12) {
+		case 0:
+			_, err = ms.RemoveMsg(rng.Uint64N(state.LastSeq + 2))
+			require_NoError(t, err)
+		case 1:
+			_, err = ms.EraseMsg(rng.Uint64N(state.LastSeq + 2))
+			require_NoError(t, err)
+		case 2:
+			_, err = ms.PurgeEx(subjects[rng.IntN(len(subjects))], 0, uint64(rng.IntN(3)))
+			require_NoError(t, err)
+		case 3:
+			_, err = ms.Compact(rng.Uint64N(state.LastSeq + 2))
+			require_NoError(t, err)
+		case 4:
+			require_NoError(t, ms.Truncate(rng.Uint64N(state.LastSeq+1)))
+		case 5:
+			_, err = ms.SkipMsg(0)
+			require_NoError(t, err)
+		default:
+			_, _, err = ms.StoreMsg(subjects[rng.IntN(len(subjects))], nil, []byte("payload"), 0)
+			require_NoError(t, err)
+		}
+		check()
+	}
+	_, err = ms.Purge()
+	require_NoError(t, err)
+	check()
+}
