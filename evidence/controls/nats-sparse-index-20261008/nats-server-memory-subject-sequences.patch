+// Ceil returns the smallest member greater than or equal to seq. The boolean
+// distinguishes an empty result from the valid sequence zero. It examines one
+// AVL search path and at most the fixed number of buckets in a node.
+func (ss *SequenceSet) Ceil(seq uint64) (uint64, bool) {
+	if ss == nil {
+		return 0, false
+	}
+	return ss.root.ceil(seq)
+}
+
+func (n *node) ceil(seq uint64) (uint64, bool) {
+	if n == nil {
+		return 0, false
+	}
+	if seq < n.base {
+		if next, ok := n.l.ceil(seq); ok {
+			return next, true
+		}
+		seq = n.base
+	}
+	offset := seq - n.base
+	if offset < numEntries {
+		bucket := offset / bitsPerBucket
+		mask := n.bits[bucket] & (^uint64(0) << (offset % bitsPerBucket))
+		for {
+			if mask != 0 {
+				return n.base + bucket*bitsPerBucket + uint64(bits.TrailingZeros64(mask)), true
+			}
+			bucket++
+			if bucket == numBuckets {
+				break
+			}
+			mask = n.bits[bucket]
+		}
+	}
+	return n.r.ceil(seq)
 }
 
