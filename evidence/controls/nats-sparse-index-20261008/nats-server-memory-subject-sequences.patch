+func TestSeqSetCeilReference(t *testing.T) {
+	var nilSet *SequenceSet
+	if _, ok := nilSet.Ceil(0); ok {
+		t.Fatal("nil set returned a member")
+	}
+	var ss SequenceSet
+	reference := make(map[uint64]bool)
+	probes := []uint64{0, 1, 63, 64, 65, numEntries - 1, numEntries, numEntries + 1, math.MaxUint64 - 1, math.MaxUint64}
+	verify := func() {
+		t.Helper()
+		expected := make([]uint64, 0, len(reference))
+		for seq := range reference {
+			expected = append(expected, seq)
+		}
+		slices.Sort(expected)
+		for _, start := range probes {
+			index, _ := slices.BinarySearch(expected, start)
+			seq, ok := ss.Ceil(start)
+			if ok != (index < len(expected)) || (ok && seq != expected[index]) {
+				t.Fatalf("Ceil(%d)=(%d,%t); reference index=%d values=%v", start, seq, ok, index, expected)
+			}
+		}
+	}
+	verify()
+	rng := rand.New(rand.NewPCG(0x123456, 0xfedcba))
+	values := append([]uint64(nil), probes...)
+	for i := 0; i < 1024; i++ {
+		values = append(values, rng.Uint64())
+	}
+	for _, seq := range values {
+		probes = append(probes, seq)
+		if seq > 0 {
+			probes = append(probes, seq-1)
+		}
+		if seq < math.MaxUint64 {
+			probes = append(probes, seq+1)
+		}
+		ss.Insert(seq)
+		ss.Insert(seq) // Duplicate inserts must not affect the successor.
+		reference[seq] = true
+	}
+	verify()
+	rng.Shuffle(len(values), func(i, j int) { values[i], values[j] = values[j], values[i] })
+	for i, seq := range values {
+		if !ss.Delete(seq) {
+			t.Fatalf("missing stored sequence %d", seq)
+		}
+		delete(reference, seq)
+		if i%31 == 0 {
+			verify()
+		}
+	}
+	verify()
+	// Empty preallocated nodes and non-aligned bases are valid states.
+	if err := ss.SetInitialMin(123); err != nil {
+		t.Fatal(err)
+	}
+	verify()
+	for _, seq := range []uint64{123, 124, 186, 187, 4096} {
+		ss.Insert(seq)
+		reference[seq] = true
+	}
+	for seq := uint64(0); seq < 4200; seq++ {
+		probes = append(probes, seq)
+	}
+	verify()
+}
+
+func TestSeqSetHighSequenceRange(t *testing.T) {
+	var ss SequenceSet
+	values := []uint64{math.MaxUint64, math.MaxUint64 - 1, math.MaxUint64 - 63, math.MaxUint64 - 2048, 0, 1}
+	for _, seq := range values {
+		ss.Insert(seq)
+	}
+	for _, seq := range values {
+		if !ss.Exists(seq) {
+			t.Fatalf("stored high sequence %d cannot be found", seq)
+		}
+		ss.Insert(seq)
+	}
+	if ss.Size() != len(values) {
+		t.Fatalf("duplicate inserts changed size: %d", ss.Size())
+	}
+	for _, seq := range values {
+		if !ss.Delete(seq) || ss.Exists(seq) {
+			t.Fatalf("cannot remove high sequence %d", seq)
+		}
+	}
+	if ss.Size() != 0 || ss.Nodes() != 0 {
+		t.Fatal("deleted set retained nodes or values")
+	}
+}
