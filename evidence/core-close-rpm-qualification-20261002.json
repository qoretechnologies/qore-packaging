  "state": "Native fixes, 21-job CI and all three local RPM/installed targets pass; native OBS and ARM installed qualification remain pending",
  "root_causes": [
    {
      "issue": "socket-close race",
      "cause": "A submission between cancellation and close can wait indefinitely because closing an epoll/kqueue descriptor removes registration without generating readiness.",
      "fix": "Wake matching socket operations on every live controller context after close, including custom thread routes. Existing descriptor generation checks deliver SOCKET-CLOSED.",
      "before": "results/core-close-regression-before-tests-1.log",
      "after": "results/core-close-fixed-native-counts-5.log"
    },
    {
      "issue": "I/O controller resize leak",
      "cause": "Replacing contexts cleared unique_ptr contexts whose raw event loop and notifier resources had no owning destructor.",
      "fix": "IoThreadContext owns and destroys its resources; prepare all replacement contexts before swapping.",
      "before": "results/core-close-native-valgrind-1.log"
    },
    {
      "issue": "HTTP completion signals a closed notifier",
      "cause": "Promise actions held private notifier data after the descriptor-owning Qore EventNotifier object was destroyed.",
      "fix": "PromiseNotifierAction and StreamingHeadersPromiseNotifierAction retain the Qore object until completion cleanup.",
      "before": "results/core-close-async-fd-valgrind-1.log",
      "before_fd_errors": 195
    }
  ],
