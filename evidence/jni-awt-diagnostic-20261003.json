    "commit": "bb6b279495ceff8442dbd0225756b92d466d5309",
    "url": "https://raw.githubusercontent.com/openjdk/jdk21u/bb6b279495ceff8442dbd0225756b92d466d5309/src/java.desktop/share/native/libfontmanager/hb-jdk-font.cc",
    "sha256": "8027d83a94f5bbb00ffc26cf8a46e4ee6b6181d53456db5ceb8637a2083a9544",
    "functions": [
      "hb_jdk_get_glyph_h_advance",
      "hb_jdk_get_glyph_v_advance",
      "reference_table"
    ]
  },
  "control_source": "// Copyright 2026 Qore Technologies, s.r.o.\nimport java.awt.Font;\nimport java.awt.font.FontRenderContext;\nimport java.awt.font.TextLayout;\nimport java.awt.geom.AffineTransform;\npublic class TextLayoutControl {\n    public static void main(String[] args) {\n        FontRenderContext context = new FontRenderContext(new AffineTransform(), true, true);\n        for (String family : new String[] {\"Calibri\", \"Dialog\", \"SansSerif\"}) {\n            Font font = new Font(family, Font.PLAIN, 11);\n            TextLayout layout = new TextLayout(\"0\", font, context);\n            if (!Float.isFinite(layout.getAdvance()) || layout.getAdvance() <= 0) {\n                throw new AssertionError(\"Invalid glyph advance: \" + family);\n            }\n            System.out.println(family + \": \" + layout.getAdvance());\n        }\n    }\n}\n",
