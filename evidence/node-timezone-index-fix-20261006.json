      638,
      2147483647
    ],
    "negative_executions": 20,
    "fixed_memory": "Zero errors for valid and intentional-abort controls. Valid runs free all allocations; leak accounting is not used for deliberate CHECK aborts.",
    "compiler": "Original GCC13 warning reproduced. Both fixed builds pass -Wall -Wextra -Werror.",
    "package_helper": "5,104 valid lookups and four invalid boundaries pass with the actual Leap RPM optflags; the original source fails the unchanged helper.",
    "packaging_tests": "22 dependency manifest/build-flag tests pass."
  },
  "limits": [
    "Function body is extracted verbatim and uses real ICU. Only namespace/UTC constant and CHECK failure adapter are local.",
    "The internal method is not dynamically exported by libnode; this control does not call the final shared library method.",
    "Complete Node runtime regression and native OBS builds remain required."
  ],
