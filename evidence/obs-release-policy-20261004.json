    "repository": "openSUSE_Leap_16.0",
    "release_template": "<SPEC_REL>.<B_CNT>",
    "effect": "Keep the complete recipe release, then append the OBS rebuild counter; other repositories retain their inherited release policies.",
    "stable": "Carry the same configuration to the stable project before promotion."
