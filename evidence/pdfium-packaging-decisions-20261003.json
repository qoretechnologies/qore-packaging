  "status": "All three proposals approved and qualified in candidate RPMs on Fedora, openSUSE and AlmaLinux x86_64",
  "proposals": {
    "allocator": {
      "root_cause": "PDFium intentionally never deletes its general and string PartitionAllocator instances. The MemoryReclaimer registry nodes become unreachable at shared-library unload. A standalone C API plugin reproduces 96 lost bytes per unload and 960 bytes after 10 unloads on all three distributions.",
      "proposed_configuration": "Use the upstream pdf_use_partition_alloc=false GN option for the standalone shared library.",
      "tradeoff": "Use the distribution system allocator instead of PDFium PartitionAlloc pools and their allocator-specific hardening. Normal distribution compiler/linker hardening remains enabled.",
      "validation": "AlmaLinux control: all 989 unit and 830 embedder tests pass; standalone C API plugin passes Valgrind after 1, 10 and 100 load/render/text-extract/unload cycles with zero memory errors and zero lost allocations. Fedora/openSUSE RPM rebuilds remain required.",
      "approval": {
        "date": "2026-10-03",
        "user_statement": "Approve the system allocator"
      }
    },
    "debug_index": {
      "root_cause": "Distribution GDB rejects the LLVM DWARF 5 name-index augmentation. Generating a GNU index instead produces overlapping address-table entries on Fedora, including without DWZ.",
      "proposed_configuration": "Keep full DWARF 5 symbols and source, disable optional GN/RPM precomputed name indexes and DWZ for this Clang-built dependency.",
      "tradeoff": "GDB scans the complete DWARF information itself, so initial symbol loading may be slower; no debug information is removed.",
      "validation": "Installed candidate-11 RPM controls on Fedora, Leap and AlmaLinux: after removing only optional .debug_names/.gdb_index sections, GDB breaks inside FPDF_InitLibraryWithConfig, locates installed source, lists lines and prints config->version=2 without warnings.",
      "approval": {
        "date": "2026-10-03",
        "user_statement": "Approve the debugger configuration"
      }
    },
    "license_vocabulary": {
      "root_cause": "The SPDX vocabulary used by openSUSE rpmlint does not recognize the accurate custom identifiers for the AGG 2.3 license and public-domain bigint notice. Complete corresponding notices are shipped in COPYRIGHT.",
      "proposed_configuration": "Apply dependencies/pdfium-rpmlintrc, limited to the exact PDFium package family, two known architectures and two exact LicenseRef identifiers at warning severity.",
      "validation": "Actual two application RPMs: raw lint has four invalid-license warnings; proposed config has zero errors and zero warnings. Two regression tests cover the intended messages and reject other package names, licenses, severities, architectures and unrelated errors.",
      "approval": {
        "date": "2026-10-03",
        "user_statement": "Approve the narrow license filters"
      }
    }
  },
