  "status": "Final canonical process RPMs and installed runtime/SDK suites pass on all three distributions. Native CI passed. OBS revision 2 matches verified sources and passes all four enabled targets, including Fedora aarch64; publication remains disabled.",
  "pid_race": {
    "root_cause": "Linux wait_task_zombie claims EXIT_DEAD before release_task unhashes the PID. A competing waiter can see ECHILD while kill(pid,0) still succeeds. Missing /proc data was then interpreted as running.",
    "kernel_source": "https://raw.githubusercontent.com/torvalds/linux/v6.4/kernel/exit.c",
    "standalone": {
      "lifetimes": 30000,
      "concurrent_reaps": 20344,
      "live_pid_windows": 36
    },
    "change": "Recognize X as exited and revalidate vanished stat files with kill(pid,0). Keep unknown/permission-denied/unavailable-proc cases conservative; do not mistake a missing proc mount for an exited PID.",
    "functional": {
      "original_cases": 57,
      "original_assertions": 429,
      "deterministic_cases": 13,
      "deterministic_assertions": 39,
      "baseline": "Public checkPid API fails when the PID disappears after its initial existence check."
    },
    "valgrind": {
      "deterministic_cases": 13,
      "memory_errors": 0,
      "lost_bytes": 0,
      "existing_affected_cases": 3,
      "existing_affected_assertions": 14,
      "parent_memory_errors": 0,
      "parent_lost_bytes": 0,
      "child_diagnostics": "Only close_range already-closed descriptor reports; see exact standalone reproduction."
    }
  },
  "diagnostics": {
    "close_range": {
      "approval": "User approved on 2026-10-03: Allow this narrow diagnostic. No suppression; only the recorded close_range/Boost.Process sites.",
      "origin": "Valgrind 3.27.1 reports a double-close for close_range over a descriptor that is already closed. The Linux API explicitly permits ranges containing closed descriptors.",
      "standalone": "fcntl duplicates stdout at fd>=20; close succeeds; close_range of exactly that descriptor with CLOSE_RANGE_UNSHARE also succeeds. Valgrind emits the same diagnostic, exits 97, and reports all allocations freed and only three inherited descriptors remaining.",
      "scope": "Only already-closed descriptor reports whose stack originates in close_range from Boost.Process close_all; actual close() double-closes, leaked descriptors and all memory diagnostics remain excluded.",
      "primary_source": "https://sourceware.org/glibc/manual/2.43/html_node/Opening-and-Closing-Files.html",
      "linux_manual": "https://man7.org/linux/man-pages/man2/close_range.2.html"
    },
    "pcre2": "The broad workstation run reproduced the already documented PCRE2 SIMD JIT diagnostic. See evidence/pilot-status-20261001.json and upstream issue 654. The affected rerun uses Qore documented QORE_PCRE2_NO_JIT=1 instrumentation setting; LLVM JIT and normal shipped settings are unchanged.",
    "allocator_rss": "The broad Valgrind run used Valgrind replacement allocation, so the unchanged releaseFreeMemory native allocator/RSS benchmark cannot measure libc trimming. The same benchmark passes in the complete native suite. It is not included in the targeted PID-state Valgrind qualification."
  },
